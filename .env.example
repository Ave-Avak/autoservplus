# =====================================================================================
# Modele de configuration de deploiement.
#
#   cp .env.example .env      puis renseigner les valeurs reelles.
#
# .env est ignore par git (voir .gitignore) et ne doit JAMAIS etre versionne : il porte
# le mot de passe de la base et la cle du prestataire de paiement. Ce modele-ci ne
# contient aucune valeur reelle.
#
# Deux pieges de format, tous deux silencieux :
#   - pas d'espace autour du signe egal, et pas de guillemets : ils seraient pris pour
#     des caracteres de la valeur ;
#   - le caractere $ est interprete par Docker Compose. Un mot de passe qui en contient
#     doit le doubler ($$), sans quoi la valeur transmise n'est pas celle qui est ecrite.
#     Le plus simple est de choisir un mot de passe sans $.
#
# Deux jeux de valeurs completes figurent en fin de fichier, l'un pour la repetition
# locale, l'autre pour le serveur.
# =====================================================================================

# --- Proxy et adresse publique ------------------------------------------------------

# Lu par Caddy. « :80 » = ecoute en HTTP sans certificat (repetition locale derriere un
# tunnel) ; un nom de domaine = certificat Let's Encrypt obtenu et renouvele seul.
DOMAINE=

# Adresse par laquelle le site est REELLEMENT joint depuis l'exterieur, telle que le
# navigateur du membre et les serveurs de Mollie la voient — pas telle que le serveur
# se voit lui-meme. Elle construit le lien de retour de paiement et l'adresse du
# webhook (URL_PUBLIQUE/webhooks/paiement) : une valeur fausse laisse le paiement
# aboutir chez Mollie sans que la commande soit jamais mise a jour ici.
# Sans barre oblique finale.
URL_PUBLIQUE=

# --- Application --------------------------------------------------------------------

# Neutralise le profil « dev » (requetes SQL journalisees, cache de gabarits desactive,
# rechargement a chaud). Aucun fichier application-prod.yml n'existe et il n'en faut
# pas : l'absence de profil dev suffit, tout le reste se regle par ces variables.
# NE JAMAIS mettre « demo » ici : ce profil cree des comptes dont les mots de passe
# sont publies dans le depot.
SPRING_PROFILES_ACTIVE=prod

# Pose l'attribut Secure sur le cookie de session. Vrai des que le site est joint en
# HTTPS — y compris en repetition locale, ou le tunnel est en HTTPS meme si Caddy sert
# l'application en clair derriere lui.
COOKIE_SECURE=true

JAVA_OPTS=-XX:MaxRAMPercentage=75

# --- Base de donnees ----------------------------------------------------------------
# DB_USER et DB_PASSWORD servent aux DEUX conteneurs : ils creent le compte dans
# PostgreSQL et servent a l'application pour s'y connecter. Une seule source, donc pas
# de derive possible entre les deux.
# Le nom d'hote « postgres » est celui du service dans le compose, pas localhost : les
# deux conteneurs se joignent par le reseau interne.
DB_URL=jdbc:postgresql://postgres:5432/autoservplus
DB_NOM=autoservplus
DB_USER=autoservplus
DB_PASSWORD=

# --- Repertoires de donnees ---------------------------------------------------------
# Chemins DANS le conteneur, adosses a des volumes nommes par le compose. L'archive des
# factures est conservee sept ans (Code TVA art. 60) : c'est le repertoire a sauvegarder
# au meme titre que la base.
FACTURES_ARCHIVE=/data/factures
MEDIAS_RACINE=/data/uploads

# --- Prestataire de paiement --------------------------------------------------------
# Laisser MOLLIE_API_KEY vide fait basculer l'application sur une passerelle bouchonnee
# qui simule le parcours de bout en bout : la chaine marchande reste praticable sans
# compte Mollie, et la page de paiement s'annonce comme simulee. Le choix se fait sur
# la PRESENCE de la cle, pas sur le profil actif.
#
# Une cle test_... ou live_... se suffit a elle-meme. Un jeton d'organisation access_...
# n'identifie pas de site : MOLLIE_PROFILE_ID devient alors obligatoire, faute de quoi
# l'application refuse de demarrer plutot que de simuler en silence.
MOLLIE_API_KEY=
MOLLIE_PROFILE_ID=
MOLLIE_MODE_TEST=true

# --- Identite legale du garage ------------------------------------------------------
# Imprimee sur les factures et les notes de credit (mentions obligatoires : Code TVA
# art. 53, AR n°1 art. 5) et composee sur les mentions legales, les CGV et la page de
# contact. Les valeurs par defaut de application.yml sont des valeurs de DEMONSTRATION :
# une facture portant un faux numero de TVA n'est pas une facture.
GARAGE_NOM_COMMERCIAL=
GARAGE_RAISON_SOCIALE=
GARAGE_RUE=
GARAGE_NUMERO_RUE=
GARAGE_CODE_POSTAL=
GARAGE_LOCALITE=
GARAGE_PAYS=Belgique
GARAGE_BCE=
GARAGE_TVA=
GARAGE_IBAN=
GARAGE_TELEPHONE=
GARAGE_COURRIEL=

# =====================================================================================
# Jeu 1 — repetition locale (Windows, Docker Desktop, tunnel Cloudflare)
#
# Caddy sert en HTTP sur le port 80 ; « cloudflared tunnel --url http://localhost:80 »
# publie une adresse HTTPS temporaire. COOKIE_SECURE reste a true : c'est le tunnel qui
# est en HTTPS, et c'est ce que voit le navigateur.
#
# L'adresse trycloudflare.com CHANGE a chaque relance du tunnel : la reporter dans
# URL_PUBLIQUE puis redemarrer le seul conteneur applicatif.
#
#   DOMAINE=:80
#   URL_PUBLIQUE=https://exemple-mot-mot-mot.trycloudflare.com
#   COOKIE_SECURE=true
#
# =====================================================================================
# Jeu 2 — serveur Hetzner CX22
#
# sslip.io resout un nom en l'adresse IP qu'il contient, sans enregistrement DNS a
# creer : de quoi obtenir un certificat Let's Encrypt valable avant d'avoir un domaine.
# Pour l'IP 203.0.113.7, le nom est 203-0-113-7.sslip.io.
#
#   DOMAINE=203-0-113-7.sslip.io
#   URL_PUBLIQUE=https://203-0-113-7.sslip.io
#   COOKIE_SECURE=true
#
# =====================================================================================
